# .env - Azure Storage Configuration for Temporal Archiver
# This file sets up environment variables that the temporal operator CLI and Azure connectors will read

# ===== AZURE STORAGE ACCOUNT CONFIGURATION =====
# Primary storage account (from your YAML config)
AZURE_STORAGE_ACCOUNT_NAME="sbeb35877611125dff411213"

# Storage account key - REPLACE WITH ACTUAL KEY FROM AZURE PORTAL
# Get this from: Azure Portal > Storage Account > Access Keys > key1 or key2
AZURE_TENANT_ID="cc0b82f3-7c2e-400b-aec3-40a3d720505b"

# Container name for temporal archival (from your YAML config)
AZURE_STORAGE_CONTAINER="atlas-fleet-group-0-archival-us3-staging-dog"

# ===== AZURE SERVICE PRINCIPAL AUTHENTICATION (Alternative to Storage Key) =====
# Uncomment and fill these if using Service Principal instead of storage key
# export AZURE_CLIENT_ID="your-service-principal-client-id"
# export AZURE_CLIENT_SECRET="your-service-principal-secret"
# export AZURE_TENANT_ID="your-azure-tenant-id"

# ===== AZURE CLOUD ENVIRONMENT =====
# Set the Azure cloud environment (usually "public" for standard Azure)
AZURE_CLOUD_ENVIRONMENT="public"

# ===== TEMPORAL-SPECIFIC AZURE CONFIGURATION =====
# These match your atlaslite configuration
ATLASLITE_ARCHIVAL_ENABLED="true"
ATLASLITE_ARCHIVAL_PROVIDER="azure"
ATLASLITE_ARCHIVAL_HISTORY_ENABLED="true"
ATLASLITE_ARCHIVAL_VISIBILITY_ENABLED="true"

# ===== TEMPORAL OPERATOR SPECIFIC =====
# Datacenter configuration (from your setup)
DD_DATACENTER="us3.staging.dog"
DD_PROVIDER="azure"

